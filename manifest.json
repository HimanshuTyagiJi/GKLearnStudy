{
  "name": "GK Learn Study",
  "short_name": "GK Learn Study",
  "description": "Learn GK anytime, anywhere",
  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "GK",
  "lang": "en",
  "orientation": "portrait",

  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "browser"
  ],

  "theme_color": "#5900b3",
  "background_color": "#ffffff",

  "icons": [
    {
      "src": "/GK-Learn-Study.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/gk_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],

  "categories": ["education"],

  "shortcuts": [
    {
      "name": "Computer",
      "short_name": "Computer",
      "url": "https://gklearnstudy.in/computer.html",
      "icons": [
        {
          "src": "/GK-Learn-Study.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Education",
      "short_name": "Education",
      "url": "https://gklearnstudy.in/education.html",
      "icons": [
        {
          "src": "/GK-Learn-Study.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "All Formulas",
      "short_name": "All Formulas",
      "url": "https://gklearnstudy.in/all-formulas.html",
      "icons": [
        {
          "src": "/GK-Learn-Study.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start GK Quiz",
      "short_name": "GK Quiz",
      "url": "https://gklearnstudy.in/gk-quiz.html",
      "icons": [
        {
          "src": "/GK-Learn-Study.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Test",
      "short_name": "My Test",
      "url": "https://gklearnstudy.in/test.html",
      "icons": [
        {
          "src": "/GK-Learn-Study.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/json": [".json"]
      }
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+gk",
      "url": "/open?data=%s"
    }
  ],

  "launch_handler": {
    "client_mode": "navigate-existing"
  },

  "edge_side_panel": {
    "preferred_width": 480,
    "options_page": "/sidepanel"
  }
}
