      <script>
        document.addEventListener("DOMContentLoaded", function () {
          // सभी एनिमेटेड एलिमेंट्स को सेलेक्ट करें
          const animatedElements =
            document.querySelectorAll(".animate-on-scroll");

          // Intersection Observer के लिए विकल्प
          const observerOptions = {
            root: null, // व्यूइंग विंडो के सापेक्ष
            rootMargin: "0px",
            threshold: 0.1, // 10% एलिमेंट दिखने पर ट्रिगर होगा
          };

          // Intersection Observer callback
          const observerCallback = (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                // एलिमेंट में .animate क्लास जोड़ें
                entry.target.classList.add("animate");
                // एक बार एनिमेशन होने के बाद ऑब्जर्वर को अनऑब्जर्व करें
                observer.unobserve(entry.target);
              }
            });
          };

          // Intersection Observer बनाएं
          const observer = new IntersectionObserver(
            observerCallback,
            observerOptions,
          );

          // प्रत्येक एनिमेटेड एलिमेंट को ऑब्जर्व करें
          animatedElements.forEach((el) => observer.observe(el));
        });
      </script>

