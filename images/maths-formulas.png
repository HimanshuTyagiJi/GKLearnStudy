      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"brackets"</span></span><span>&gt;(S</span><span><span class="hljs-tag">&lt;<span class="hljs-name">sub</span></span></span><span>&gt;n</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">sub</span></span></span><span>&gt;)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
