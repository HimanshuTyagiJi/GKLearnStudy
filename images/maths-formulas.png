  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;वृत में एक स्पर्श रेखा वृत के केंद्र से हमेशा लंबवत होती है।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 9: वृत से संबंधित रचनाएँ (Constructions)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;दी गई त्रिज्या के साथ वृत का निर्माण।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;दोनों त्रिज्या वाली वृतों के बीच स्पर्श रेखाएँ खींचना।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 10: क्षेत्रफल (Areas Related to Circles)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;वृत का क्षेत्रफल = πr²</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;वृत की परिधि = 2πr</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 11: पृष्ठीय क्षेत्रफल और आयतन (Surface Areas and Volumes)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;घन का पृष्ठीय क्षेत्रफल = 6a²</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;घनाभ का पृष्ठीय क्षेत्रफल = 2(lb + bh + hl)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;गोला का आयतन = (4/3)πr³</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 12: सांख्यिकी (Statistics)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Mean (औसत) = Σfᵢxᵢ / Σfᵢ</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Median: ग्राफ विधि द्वारा वर्गों के मध्य मान।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 13: प्रायिकता (Probability)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Probability (E) = </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"frac"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>&gt;अनुकूल परिणामों की संख्या</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"bottom"</span></span><span>&gt;कुल परिणामों की संख्या</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

