      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-table"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-row"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-cell"</span></span><span>&gt;=</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt; </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-cell frac"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>&gt;-b ± √(b² - 4ac)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"bottom"</span></span><span>&gt;2a</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
