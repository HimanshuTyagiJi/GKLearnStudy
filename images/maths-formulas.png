      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-table"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-row"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-cell"</span></span><span>&gt;=</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt; </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"equation-cell frac"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>&gt;be - cd</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">class</span></span><span>=</span><span><span class="hljs-string">"bottom"</span></span><span>&gt;ae - bd</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
