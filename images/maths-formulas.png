</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 1: वास्तविक संख्याएँ (Real Numbers)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Euclid’s Division Lemma: कोई भी दो धनात्मक पूर्णांक a और b के लिए, a = bq + r, जहाँ 0 ≤ r </span><span><span class="hljs-symbol">&amp;lt;</span></span><span> b होता है।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;LCM और HCF का संबंध: LCM × HCF = प्रथम संख्या × द्वितीय संख्या</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 2: बहुपद (Polynomials)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x + a)(x + b) = x² + (a + b)x + ab</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;x² - a² = (x + a)(x - a)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;a³ + b³ = (a + b)(a² - ab + b²)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;a³ - b³ = (a - b)(a² + ab + b²)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 10 Maths Chapter 3: रैखिक समीकरण (Pair of Linear Equations)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;ax + by + c = 0 और dx + ey + f = 0 का हल:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">b</span></span></span><span>&gt;Substitution Method</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">b</span></span></span><span>&gt;: एक चर को दूसरे चर के मान में रखकर हल करें।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">b</span></span></span><span>&gt;Elimination Method</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">b</span></span></span><span>&gt;: एक चर को समाप्त करके हल करें।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">b</span></span></span><span>&gt;Cross-Multiplication Method</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">b</span></span></span><span>&gt;:
