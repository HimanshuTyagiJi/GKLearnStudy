476 20.3159L8.97693 19.8372C9.72813 19.712 10.1037 19.6494 10.4542 19.521C10.7652 19.407 11.0608 19.2549 11.3343 19.068C11.6425 18.8575 11.9118 18.5882 12.4503 18.0497L20 10.5C21.3807 9.11929 21.3807 6.88071 20 5.5C18.6193 4.11929 16.3807 4.11929 15 5.5L7.45026 13.0497C6.91175 13.5882 6.6425 13.8575 6.43197 14.1657C6.24513 14.4392 6.09299 14.7348 5.97903 15.0458C5.85062 15.3963 5.78802 15.7719 5.66282 16.5231Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M14.5 7L18.5 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Edit</button></span></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-html"><span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span>&gt;Class 9 Maths Chapter 2 – Polynomials Formulas (Hindi)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;इस पेज पर आप कक्षा 9वीं गणित के अध्याय 2 "बहुपद (Polynomials)" के सभी महत्वपूर्ण सूत्र हिंदी में सरल तरीके से पढ़ सकते हैं। ये सूत्र परीक्षा के दृष्टिकोण से अत्यंत महत्वपूर्ण हैं।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 9 Maths Chapter 2: Polynomials (बहुपद)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;बहुपद (Polynomial) एक ऐसा व्यंजक होता है जिसमें एक या एक से अधिक चर (Variables) और उनके धनात्मक पूर्णांक घात होते हैं।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;महत्वपूर्ण सूत्र (Important Formulas)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x + a)(x + b) = x² + (a + b)x + ab</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x + a)² = x² + 2ax + a²</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x - a)² = x² - 2ax + a²</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;x² - a² = (x + a)(x - a)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(a + b + c)² = a² + b² + c² + 2ab + 2bc + 2ca</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;a³ + b³ = (a + b)(a² - ab + b²)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;a³ - b³ = (a - b)(a² + ab + b²)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;प्रमुख बहुपद पहचाने के तरीके (How to Identify Polynomials)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;यदि किसी व्यंजक में:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;चर की घात (power) पूर्णांक हो।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;घात ऋणात्मक (negative) या भिन्नांक (fraction) न हो।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;तो वह बहुपद कहलाता है।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;उदाहरण (Examples)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">b</span></span></span><span>&gt;Example 1:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">b</span></span></span><span>&gt; (x + 3)(x - 4) = x² - x - 12</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">b</span></span></span><span>&gt;Example 2:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">b</span></span></span><span>&gt; (2x + 5)² = 4x² + 20x + 25</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">b</span></span></span><span>&gt;Example 3:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">b</span></span></span><span>&gt; x² - 16 = (x + 4)(x - 4)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;महत्वपूर्ण प्रश्न (Important Questions)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(a + b)³ = ?</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x - y)³ = ?</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(p + q + r)² = ?</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

