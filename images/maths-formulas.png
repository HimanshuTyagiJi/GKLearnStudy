476 20.3159L8.97693 19.8372C9.72813 19.712 10.1037 19.6494 10.4542 19.521C10.7652 19.407 11.0608 19.2549 11.3343 19.068C11.6425 18.8575 11.9118 18.5882 12.4503 18.0497L20 10.5C21.3807 9.11929 21.3807 6.88071 20 5.5C18.6193 4.11929 16.3807 4.11929 15 5.5L7.45026 13.0497C6.91175 13.5882 6.6425 13.8575 6.43197 14.1657C6.24513 14.4392 6.09299 14.7348 5.97903 15.0458C5.85062 15.3963 5.78802 15.7719 5.66282 16.5231Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M14.5 7L18.5 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Edit</button></span></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-html"><span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Class 9 Maths Chapter 2: Polynomials (बहुपद)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;बहुपद (Polynomial) गणित का एक महत्वपूर्ण अध्याय है। इसमें हम विभिन्न प्रकार के बहुपद और उनके पहचानने के सूत्र पढ़ते हैं। यहाँ हम बहुपदों से जुड़े सभी महत्वपूर्ण सूत्र हिंदी में जानेंगे।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;महत्वपूर्ण सूत्र (Important Formulas)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x + a)(x + b) = x² + (a + b)x + ab</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x + a)² = x² + 2ax + a²</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(x - a)² = x² - 2ax + a²</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;x² - a² = (x + a)(x - a)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;प्रमुख बहुपद पहचाने के तरीके</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;यदि किसी व्यंजक में चर की घात पूर्णांक हो और कोई घात ऋणात्मक या भिन्नांक न हो तो वह बहुपद कहलाता है।</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;उदाहरण (Examples)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Example 1: (x + 3)(x - 4) = x² - x - 12</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Example 2: (2x + 5)² = 4x² + 20x + 25</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;

</span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span>&gt;महत्वपूर्ण प्रश्न (Important Questions)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
</span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;(a + b)³ = ?</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
